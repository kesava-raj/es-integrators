          },
          {
            "src": "https://framerusercontent.com/images/lxIpRAPB2GyzWXqCsmI4Lt1Bu4.jpg?width=1200&height=800",
            "alt": "About Image",
            "w": 580,
            "h": 415
          },
          {
            "src": "https://framerusercontent.com/images/d512t4V6VrGb1hhvxUjbODGCXCk.jpg?width=800&height=800",
            "alt": "About Image",
